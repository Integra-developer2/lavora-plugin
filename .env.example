# Configurazione di lavora-plugin — copia in .env e riempi.
#
# Queste skill sono nate per UN'app specifica e sono state sanificate: ogni valore reale
# (IP, host, id di ClickUp, nomi) è stato tolto e sostituito da un segnaposto ${COSÌ}. Il file
# che leggi ora è la mappa di quei segnaposti. Finché non lo compili, le skill parlano di
# macchine, workspace e persone che non esistono: adattale al tuo progetto prima di lanciarle.
#
# Le skill sono testo per un agente, non uno script: l'agente non "sorgenta" questo file da
# sé. Prima di lanciare la catena digli di leggerlo (o incollaglielo), oppure copia i valori
# a mano nelle skill — una volta sola, dove servono.

# ── L'app che sviluppi ──────────────────────────────────────────────────────────────────────
APP_NAME=TuaApp
# Come appare in prosa: "il gestionale ${APP_NAME}", "il CLAUDE.md di ${APP_NAME}".
APP_SLUG=tuaapp
# Lo slug di cartelle e DB: /var/www/html/${APP_SLUG}, ${APP_SLUG}_<n>, ${APP_SLUG}_authentication_backend.
APP_NAME_UPPER=TUAAPP
# Raro: solo dove l'originale usava il nome tutto maiuscolo (es. intestazioni di riferimenti fissi).

# ── Le due VM di sviluppo (coppie di slot paralleli, stesso DB) ────────────────────────────
# Il progetto originale ne usa due identiche: una "principale" (dev1) e una "di scorta" (dev2),
# ciascuna con le sue varianti di slot (cartella_<n>) servite da un proxy locale. Se hai una
# sola VM, riempi solo il blocco DEV1 e togli dalle skill i riferimenti a dev2 (apri-dev2 in
# particolare non ti serve).
DEV1_IP=10.0.1.20
# L'IP della prima VM in LAN.
DEV1_LABEL=dev1
# L'etichetta breve usata negli host locali: gestione.${DEV1_LABEL}.${LOCAL_TLD}.
DEV1_NUM=20
# Il numero che la convenzione [devNN] del titolo della chat usa per indicare "questa macchina,
# non serve specificarla". Nell'originale era l'ultimo ottetto dell'IP; può essere qualunque cosa.
DEV1_SSH_ALIAS=dev1
# L'alias SSH configurato in ~/.ssh/config per raggiungere DEV1_IP senza scriverlo ogni volta.

DEV2_IP=10.0.1.28
DEV2_LABEL=dev2
DEV2_NUM=28
DEV2_SSH_ALIAS=dev2

DB_IP=10.0.1.30
# Il DB di test condiviso da tutte le VM e tutti gli slot.
DEV_IP_PREFIX=10.0.1
# Il prefisso comune delle VM di sviluppo, usato dove le skill parlano di "una macchina
# qualunque della rete" (es. `root@${DEV_IP_PREFIX}.NN` per un `[devNN]` non elencato sopra).

# ── Dominio locale e pubblico ────────────────────────────────────────────────────────────────
LOCAL_TLD=tuaapp.localhost
# Lo pseudo-dominio *.localhost su cui gira il proxy del browser integrato
# (gestione.${DEV1_LABEL}.${LOCAL_TLD}, gestione.${DEV1_LABEL}-<n>.${LOCAL_TLD}).
PUBLIC_DOMAIN=tuaapp.net
# Il dominio con cui si raggiungono le VM per nome dal browser normale (non dalla sandbox).

# ── ClickUp ───────────────────────────────────────────────────────────────────────────────
CLICKUP_WORKSPACE_ID=0000000000
CLICKUP_WORKSPACE_NAME=NOME WORKSPACE
CLICKUP_SPACE_ID=00000000000
# Lo Space dentro il workspace dove vivono le task di sviluppo.
CLICKUP_FIELD_BRANCH=00000000-0000-0000-0000-000000000000
# Il custom field (short_text) dove scrivi il nome del branch sulla task: è la chiave che lega
# branch -> task in tutta la catena.
CLICKUP_FIELD_DA_FARE=00000000-0000-0000-0000-000000000000
# Il custom field (labels) con le opzioni SQL / PERMESSI / PROCEDURE.
CLICKUP_FIELD_LOAD_INSTRUCTIONS=00000000-0000-0000-0000-000000000000
# Il custom field (text) "Istruzioni Caricamento [Sviluppatore]" o equivalente.
CLICKUP_FIELD_TEST_INSTRUCTIONS=00000000-0000-0000-0000-000000000000
# Il custom field (text) "Istruzioni Test" o equivalente.

# ── Il tuo account e il tuo team ─────────────────────────────────────────────────────────────
YOUR_NAME=NomeTuo
# Usato per firmare: il tag `#CLAUDE-${YOUR_TAG}` nei commenti ClickUp, e come esempio di
# prefisso nei nomi di branch (${YOUR_NAME}-area-slug).
YOUR_TAG=NomeTuo
# Di norma uguale a YOUR_NAME; separato per poterlo accorciare (iniziali) senza toccare l'altro.
YOUR_USER_ID=00000000
# Il tuo id utente ClickUp (numerico).
TEST_ACCOUNT_EMAIL=dev-test@tuaapp.it
# L'account di test sulle VM di sviluppo — l'unico per cui le skill del browser integrato
# possono fare login da sole. Vedi il perimetro descritto in apri-dev1/apri-dev2: mai
# allargarlo per analogia a un account reale.

# Compagni di squadra citati nelle skill (assegnatari ricorrenti, autori di commenti negli
# esempi, nomi di campi come "Test <nome>"). Ne servono quanti ne citavano le skill originali;
# aggiungine altri nello stesso stile se il tuo team è più grande.
TEAMMATE1_NAME=Collega1
TEAMMATE1_USER_ID=00000000
TEAMMATE2_NAME=Collega2
TEAMMATE2_USER_ID=00000000
TEAMMATE3_NAME=Collega3
# (TEAMMATE3 compare solo nel nome di un custom field "Test ${TEAMMATE3_NAME}": non ha un suo id.)
